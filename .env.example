# Hotel Booking API (BillJu / HMS POS)
# Copy to .env.local and adjust for your environment.

# Base URL without trailing slash
NEXT_PUBLIC_HOTEL_API_URL=https://hmsposbookingsystem.navyom.com/hotel-api

# Multi-tenant hotel id (admin_users.id)
NEXT_PUBLIC_RESTAURANT_ID=1

# Optional: hostname of room photo URLs if different from API host
# NEXT_PUBLIC_API_IMAGE_HOST=https://hmsposbookingsystem.navyom.com
